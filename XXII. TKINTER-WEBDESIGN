import tkinter as tk

# Create main window
root = tk.Tk()
root.title("Simple Calculator - Addition")
root.geometry("520x480")

# Function to perform addition
def add_numbers():
    try:
        num1 = float(entry1.get())
        num2 = float(entry2.get())
        result = num1 + num2
        entry_result.delete(0, tk.END)
        entry_result.insert(0, str(result))
    except ValueError:
        entry_result.delete(0, tk.END)
        entry_result.insert(0, "Invalid input")

# First number input
tk.Label(root, text="Enter first number:").grid(row=0, column=0, padx=10, pady=5, sticky="e")
entry1 = tk.Entry(root, width=25)
entry1.grid(row=0, column=1, padx=10, pady=5)

# Second number input
tk.Label(root, text="Enter second number:").grid(row=1, column=0, padx=10, pady=5, sticky="w")
entry2 = tk.Entry(root, width=25)
entry2.grid(row=1, column=1, padx=10, pady=5)

# Add Button
tk.Button(root, text="Add", width=10, command=add_numbers).grid(row=2, column=1, pady=10, sticky="w")

# Result display
tk.Label(root, text="Result:").grid(row=3, column=0, padx=10, pady=5, sticky="e")
entry_result = tk.Entry(root, width=25)
entry_result.grid(row=3, column=1, padx=10, pady=5)

# Start GUI
root.mainloop()