# Create main window
root = tk.Tk()
root.title("Name Greeting App")
root.geometry("300x200")

# Function to handle button click
def greet_user():
    nm = n.get()  # Get text from first entry
    message = f"Hello, {nm}!"
    n.delete(0,tk.END)
    output_entry.delete(0, tk.END)       # Clear previous message
    output_entry.insert(0, message)      # Display new message

# Input text field
tk.Label(root, text="Enter your name:").pack(pady=5)
n= tk.Entry(root, width=30)
n.pack(pady=5)

# Button
tk.Button(root, text="Greet Me", command=greet_user).pack(pady=10)

# Output text field
tk.Label(root, text="Greeting:").pack(pady=5)
output_entry = tk.Entry(root, width=30)
output_entry.pack(pady=5)

# Start the GUI
root.mainloop()





