import sqlite3
import tkinter as tk
from tkinter import messagebox

# ---------------- DB Setup ---------------- #
def connect_db():
    conn = sqlite3.connect("mydatabase.db")
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS students (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            age INTEGER,
            marks REAL
        )
    ''')
    conn.commit()
    conn.close()

# ---------------- Functions ---------------- #
def insert_record():
    name = name_entry.get()
    age = age_entry.get()
    marks = marks_entry.get()

    if name and age and marks:
        conn = sqlite3.connect("mydatabase.db")
        cursor = conn.cursor()
        cursor.execute("INSERT INTO students (name, age, marks) VALUES (?, ?, ?)", (name, age, marks))
        conn.commit()
        conn.close()
        show_records()
        clear_fields()
        messagebox.showinfo("Inserted", "Record inserted successfully.")
    else:
        messagebox.showwarning("Input Error", "All fields are required!")

def update_record():
    selected = listbox.curselection()
    if selected:
        index = selected[0]
        record_id = listbox.get(index).split()[0]  # first part is ID

        name = name_entry.get()
        age = age_entry.get()
        marks = marks_entry.get()

        conn = sqlite3.connect("mydatabase.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE students SET name=?, age=?, marks=? WHERE id=?", (name, age, marks, record_id))
        conn.commit()
        conn.close()
        show_records()
        clear_fields()
        messagebox.showinfo("Updated", "Record updated successfully.")
    else:
        messagebox.showwarning("Select Record", "Please select a record to update.")

def delete_record():
    selected = listbox.curselection()
    if selected:
        index = selected[0]
        record_id = listbox.get(index).split()[0]

        conn = sqlite3.connect("mydatabase.db")
        cursor = conn.cursor()
        cursor.execute("DELETE FROM students WHERE id=?", (record_id,))
        conn.commit()
        conn.close()
        show_records()
        clear_fields()
        messagebox.showinfo("Deleted", "Record deleted successfully.")
    else:
        messagebox.showwarning("Select Record", "Please select a record to delete.")

def show_records():
    listbox.delete(0, tk.END)
    conn = sqlite3.connect("mydatabase.db")
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM students")
    rows = cursor.fetchall()
    for row in rows:
        listbox.insert(tk.END, f"{row[0]} {row[1]} {row[2]} {row[3]}")
    conn.close()

def clear_fields():
    name_entry.delete(0, tk.END)
    age_entry.delete(0, tk.END)
    marks_entry.delete(0, tk.END)

def on_listbox_select(event):
    selected = listbox.curselection()
    if selected:
        index = selected[0]
        data = listbox.get(index).split()
        name_entry.delete(0, tk.END)
        age_entry.delete(0, tk.END)
        marks_entry.delete(0, tk.END)

        name_entry.insert(0, data[1])
        age_entry.insert(0, data[2])
        marks_entry.insert(0, data[3])

# ---------------- GUI Setup ---------------- #
connect_db()

root = tk.Tk()
root.title("Student Management")
root.geometry("400x450")

# Labels and Entries
tk.Label(root, text="Name").pack(pady=2)
name_entry = tk.Entry(root)
name_entry.pack()

tk.Label(root, text="Age").pack(pady=2)
age_entry = tk.Entry(root)
age_entry.pack()

tk.Label(root, text="Marks").pack(pady=2)
marks_entry = tk.Entry(root)
marks_entry.pack()

# Buttons
tk.Button(root, text="Insert", command=insert_record).pack(pady=5)
tk.Button(root, text="Update", command=update_record).pack(pady=5)
tk.Button(root, text="Delete", command=delete_record).pack(pady=5)
tk.Button(root, text="Show All", command=show_records).pack(pady=5)

# Listbox
listbox = tk.Listbox(root, width=50)
listbox.pack(pady=10)
listbox.bind('<<ListboxSelect>>', on_listbox_select)

show_records()

root.mainloop()