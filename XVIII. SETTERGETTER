        print("my name =", self.__name)
        print("my rollno =", self.__rollno)
        print("my mark =", self.__mark)

    def update(self, name, rollno, mark):  # Setter-like method
        self.__name = name
        self.__rollno = rollno
        self.__mark = mark

# Object creation and usage
s = Student("muna", 1, 90.50)
s.show()                      # Show initial details

s.update("muna das", 1, 80.50)  # Update details
s.show()                     # Show updated details


