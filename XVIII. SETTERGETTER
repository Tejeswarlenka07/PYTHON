        self.__rollno = 0
        self.__name=""
        self.__mark=0.0
    @property
    def marks(self):            # getter
        return self.__marks
    @property
    def name(self):            # getter
        return self.__name
    @property
    def rollno(self):            # getter
        return self.__rollno
    @marks.setter
    def marks(self, value):     # setter
        if value >= 0:
            self.__marks = value
    @rollno.setter
    def rollno(self, value):     # setter
            self.__rollno =value
    @name.setter
    def name(self,name):     # setter
            self.__name = name
