(3)check no is even or odd     function name check()

def check():
	print("enter a number ")
	no=int(input())
	if no%2==0:
		print("even number ")
	else:
		print("odd number ")
check()




no return value with argument
_____________________________
(1)no return value  argument  add two nos
def add(no1,no2):
    s=no1+no2
    print("sum=",s)
    return 
add(10,20)
add(30,40)

or
def add(no1,no2):
    s=no1+no2
    print("sum=",s)
    return 
print("enter two nos ")
no1=int(input())
no2=int(input())
add(no1,no2)

or
def add(x,y):     # x ,y formal argument
    s=x+y
    print("sum=",s)
    return 
print("enter two nos ")
no1=int(input())
no2=int(input())
add(no1,no2)   #function call  no1,no2 acutal parameter  or actual argument

(2)no return value no argument simpleinterset   function name   sical()

def sical(p,r,t):
	si=p*r*t/100
	print("simple interset=",si)
print("enter piniciple rate and time ")
p=int(input())
r=int(input())
t=int(input())
sical(p,r,t)


(3)check no is even or odd     function name check()
def check(no):
	if no%2==0:
		print("even number ")
	else:
		print("odd number ")
	return
print("enter a number ")
no=int(input())
check(no)


