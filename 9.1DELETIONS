Full Example  class variable : (Create & Delete Both)
class Student:
    @classmethod
    def add_college(cls, name):
        cls.college = name

    @classmethod
    def remove_college(cls):
        del cls.college

# Create
Student.add_college("IIT")
print(Student.college)  # IIT

# Delete
Student.remove_college()
# print(Student.college)  # AttributeError





