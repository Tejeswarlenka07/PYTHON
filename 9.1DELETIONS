 Delete a Class Variable in a Method

class Demo:
    class_var = 50  # class variable

    @classmethod
    def delete_class_var(cls):
        del cls.class_var

print(Demo.class_var)  # 50
Demo.delete_class_var()
# print(Demo.class_var)  # Error: AttributeError

